{
    "name": "survos/quickbase-bundle",
    "description": "Symfony integration for the Quickbase JSON REST API, with a scoped client and record upserts.",
    "keywords": ["symfony", "quickbase", "api", "integration"],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.6",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/test-pack": "^1.0"
    },
    "autoload": {"psr-4": {"Survos\\QuickbaseBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Survos\\QuickbaseBundle\\Tests\\": "tests/"}},
    "extra": {"symfony": {"require": "^8.1"}},
    "prefer-stable": true
}
